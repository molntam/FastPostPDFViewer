{
  "manifest_version": 3,
  "name": "Fast POST PDF Auto Printer",
  "version": "1.2.1",
  "description": "Loads original POST-generated PDFs from solutions.inet-logistics.com in Edge and opens the print dialog automatically.",
  "minimum_chrome_version": "151",
  "key": "",
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "viewer.html",
      "can_embed": true
    }
  }
}
