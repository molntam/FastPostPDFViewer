{
  "manifest_version": 3,
  "name": "Fast POST PDF Viewer",
  "version": "1.0.4",
  "description": "Displays PDFs from solutions.inet-logistics.com, including POST responses, in a fast local viewer.",
  "minimum_chrome_version": "151",
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "viewer.html",
      "can_embed": true
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
