{
  "manifest_version": 3,
  "name": "Fast POST PDF Printer",
  "version": "1.0.6",
  "description": "Prints PDFs from solutions.inet-logistics.com directly from a 600 DPI canvas without PNG conversion.",
  "minimum_chrome_version": "151",
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "viewer.html",
      "can_embed": true
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
