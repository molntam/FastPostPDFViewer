{
  "manifest_version": 3,
  "name": "Fast POST PDF PPM Printer",
  "version": "1.1.0",
  "description": "Sends original POST-generated PDFs from solutions.inet-logistics.com to Windows Personal Print Manager queues without browser rasterization.",
  "minimum_chrome_version": "151",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "viewer.html",
      "can_embed": true
    }
  }
}
