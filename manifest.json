{
  "manifest_version": 3,
  "name": "Fast POST PDF Printer Ultra",
  "version": "1.1.0",
  "description": "Prints captured PDFs immediately from an adaptive canvas targeting 1200 DPI.",
  "minimum_chrome_version": "151",
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "viewer.html",
      "can_embed": true
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
